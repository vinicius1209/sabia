# Copie para .env e preencha. O .env NUNCA vai pro git.

# Conta do ClassApp (login por celular). Use so conta sua, ou com
# autorizacao de quem e dono dela.
CLASSAPP_PHONE=47900000000
CLASSAPP_PASSWORD=

# Quem e a dona da conta (aparece no prompt do agente e no topo da UI)
ALUNO_NOME=
ALUNO_SERIE=3º ano do Ensino Médio
ESCOLA_NOME=

# Motor de IA: openai (padrao), gemini, ou local (sem IA, so regras)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Gemini (alternativa)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Porta do servidor local
PORT=8123
# Quem pode acessar. 127.0.0.1 = so esta maquina (padrao, recomendado).
# 0.0.0.0 = qualquer um na rede le as notas da conta logada.
HOST=127.0.0.1
# Quanto tempo esperar alguem digitar o codigo 2FA (ms)
PRAZO_2FA_MS=180000
# Mostrar o navegador (1 = visivel na feira, 0 = headless)
SHOW_BROWSER=1
