# OPCIONAL. O primeiro uso na tela pede tudo isto e guarda em ~/.sabia.
# Se preferir arquivo: copie para .env; na primeira execução ele é importado
# para ~/.sabia/config.json. O .env NUNCA vai pro git.

# Conta do ClassApp (login por celular). Use so conta sua, ou com
# autorizacao de quem e dono dela.
CLASSAPP_PHONE=47900000000
CLASSAPP_PASSWORD=

# Quem e a dona da conta (aparece no prompt do agente e na tela)
ALUNO_NOME=
ALUNO_SERIE=3º ano do Ensino Médio
ESCOLA_NOME=

# Motor de IA. auto (padrao) = a primeira CLI por assinatura logada nesta
# maquina (claude, agy, codex), sem gastar com chave. Ou fixe um:
# claude, agy, codex, openai, gemini, local (sem IA)
LLM_PROVIDER=auto

# OpenAI (chave de API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Claude, Antigravity e Codex pela assinatura: usam o login das CLIs desta
# maquina, sem chave. So escolhem o modelo.
CLAUDE_MODEL=sonnet
AGY_MODEL=gemini-3.8-flash-low
CODEX_MODEL=

# Gemini (chave de API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Porta do servidor local
PORT=8123
# Quem pode acessar. 127.0.0.1 = so esta maquina (padrao, recomendado).
# 0.0.0.0 = qualquer um na rede le as notas da conta logada.
HOST=127.0.0.1
# Quanto tempo esperar alguem digitar o codigo 2FA (ms)
PRAZO_2FA_MS=180000
# Mostrar o navegador (1 = visivel na feira, 0 = escondido)
SHOW_BROWSER=1

# Onde ficam config, sessao e conversas (padrao ~/.sabia)
# SABIA_HOME=
# Qual pacote de agente rodar, em src/agentes/<id> (padrao sabia)
# SABIA_AGENTE=
# 0 = nao abrir o navegador sozinho no npm start
# SABIA_ABRIR=
